Decision:
  jev:
    api_key: ""
    base_url: https://api.typesafe.ai
    proxy: http://127.0.0.1:7897
    enabled: false
    endpoint:
      enabled: true
      fastpath_enabled: true
      fastpath_imperative_min_chars: 2
      fastpath_max_chars: 14
      incomplete_hold_max_count: 3
      incomplete_hold_ms: 900
      preview_non_stream: true
      threshold: 0.40
    memory:
      candidate_limit: 30
      enabled: true
      max_questions: 50
      threshold: 0.55
